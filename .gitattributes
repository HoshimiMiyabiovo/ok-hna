# 统一换行，避免 Windows 上 CRLF 抖动
* text=auto
*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.txt   text eol=lf
*.ps1   text eol=crlf
*.bat   text eol=crlf

# 二进制
*.png   binary
*.jpg   binary
*.jpeg  binary
*.onnx  binary
*.pyd   binary
*.dll   binary
*.exe   binary
